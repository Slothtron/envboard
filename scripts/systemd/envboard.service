# envboard 工作台的用户级服务单元（v3）。
#
# 装法（不需要 root；产物是单一二进制，cargo build --release --locked 后取
# target/release/envboard，或 cargo install --path core/rs/crates/envboard-web）：
#   install -Dm755 target/release/envboard ~/.local/bin/envboard
#   install -Dm644 scripts/systemd/envboard.service ~/.config/systemd/user/envboard.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now envboard
#
# v3 的形态：envboard 是**单个进程** —— 管理器、引擎实例（每环境一个线程 +
# 一个监听）与工作台 HTTP 面都在这一个进程里。没有子进程、没有第二运行时：
#   * cgroup 里看到的就是全部；停服务 = 停工作台 = 停所有实例（引擎随进程一起
#     退出，端口即刻释放，不存在"孤儿代理"）；
#   * 崩溃隔离是任务级的（请求任务 panic 只死那一条连接）；引擎线程 panic 会
#     把该实例记为 failed，reconcile 按期望状态自动重拉 —— 因此 release 构建
#     必须保持 panic=unwind（禁止 abort），这条写在 spec/capabilities.md
#     的「实例生命周期」，是构建契约不是实现细节。
#
# 只监听回环 —— 回环档默认免鉴权（本机即本机用户）。要让别的机器用：显式改监听
# 地址并**必须**带 --token（非回环不给 token 会拒绝启动，这是刻意设计），并建议
# 同时开环境的代理鉴权。见 README「工作台鉴权与对外暴露」。

[Unit]
Description=envboard — 多环境代理管理器与工作台（进程内 Rust 引擎）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 绝对路径：systemd 用户服务不继承交互 shell 的 PATH。
ExecStart=%h/.local/bin/envboard \
    --state-dir %h/.envboard \
    --listen 127.0.0.1:8900
Restart=on-failure
RestartSec=2
# 状态目录私有（实例日志、规则账本、CA 私钥都在里面），权限从 0700 起步。
RuntimeDirectory=envboard
NoNewPrivileges=true
# 签证书与放宽名单都是库内行为，不需要任何特权位。
ProtectSystem=full
ProtectControlGroups=true
# 引擎自己的运行日志进 journald；代理流水在 <state-dir>/logs/<env>.log，两轨互不干扰。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

# 工作台就是唯一的常驻形态（v0.2 起没有无界面的 run 变体）：实例活在进程内，
# 停服务 = 停工作台 = 停所有实例。要让服务在没有登录会话时也活着：
#   loginctl enable-linger $USER
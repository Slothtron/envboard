{
  "capability": "proxy.validate",
  "description": "凭据同生共死：只给 user 时错误指向缺失的 password（不回显取值）",
  "input": {
    "name": "corp",
    "host": "proxy.example.com",
    "port": 3128,
    "user": "alice"
  },
  "expect": {
    "ok": false,
    "code": "invalid_config",
    "field": "proxy.password"
  }
}

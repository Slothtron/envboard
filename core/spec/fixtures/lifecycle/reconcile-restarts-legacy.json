{
  "capability": "instance.reconcile",
  "description": "在跑但状态文件没有配置哈希回执（上一代二进制拉起的实例）：期望 running 时走 restart，而不是让它继续按旧配置跑",
  "input": {
    "instances": [
      {
        "env": "beta",
        "desired": "running",
        "record": {
          "pid": 111,
          "starttime": 900,
          "cmdline": [
            "mitmdump",
            "-s",
            "/home/u/.state/agent/beta/envboard_mitmproxy.py",
            "--set",
            "listen_port=16301"
          ]
        },
        "live": {
          "pid": 111,
          "starttime": 900,
          "cmdline": [
            "mitmdump",
            "-s",
            "/home/u/.state/agent/beta/envboard_mitmproxy.py",
            "--set",
            "listen_port=16301"
          ]
        },
        "listen_port": 16301,
        "legacy": true
      }
    ],
    "occupied_by_others": []
  },
  "expect": {
    "ok": true,
    "actions": [
      [
        "beta",
        "restart"
      ]
    ]
  }
}

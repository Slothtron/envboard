          "starttime": 900,
          "cmdline": ["mitmdump", "-s", "/home/u/.envboard/agent/envboard_mitmproxy.py", "--set", "listen_port=16301"]
        },
        "live": {
          "pid": 111,
          "starttime": 1200,
          "cmdline": ["mitmdump", "-s", "/home/u/.envboard/agent/envboard_mitmproxy.py", "--set", "listen_port=16301"]
        }
      }
    ],
    "occupied_by_others": []
  },
  "expect": { "ok": true, "actions": [["alpha", "keep"]], "warnings": ["pid_reuse_suspected"] }
}

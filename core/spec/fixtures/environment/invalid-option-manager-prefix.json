{
  "capability": "environment.validate",
  "description": "反例：envboard_ 前缀是管理器与注入器之间的约定，不允许从环境选项覆盖",
  "input": {
    "name": "bad",
    "listen": { "port": 16308 },
    "options": { "envboard_rules": "/tmp/other.rules" }
  },
  "expect": {
    "ok": false,
    "code": "invalid_config",
    "field": "environment.options.envboard_rules"
  }
}

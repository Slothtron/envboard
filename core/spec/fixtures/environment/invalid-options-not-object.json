{
  "capability": "environment.validate",
  "description": "options 必须是对象（这里给的是数组），错误路径指向 options 本身",
  "input": {
    "name": "bad",
    "listen": { "port": 16303 },
    "options": ["ssl_insecure=true"]
  },
  "expect": {
    "ok": false,
    "code": "invalid_config",
    "field": "environment.options"
  }
}

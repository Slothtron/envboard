{
  "capability": "environment.validate",
  "description": "选项键不能为空 —— 空键无法定位到 `environment.options.<key>`，于是指向 options 本身",
  "input": {
    "name": "bad",
    "listen": { "port": 16305 },
    "options": { "": "true" }
  },
  "expect": {
    "ok": false,
    "code": "invalid_config",
    "field": "environment.options"
  }
}

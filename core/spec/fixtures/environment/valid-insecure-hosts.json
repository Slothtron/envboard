{
  "capability": "environment.validate",
  "description": "放行域名清单：trim + 小写 + 去尾部根点，然后去重并按字典序持久化（同一份输入永远同一份列表）",
  "input": {
    "name": "beta",
    "listen": {
      "port": 16301
    },
    "insecure_hosts": [
      " Web.Example.NET. ",
      "app.example.com",
      "App.Example.COM"
    ]
  },
  "expect": {
    "ok": true,
    "insecure_hosts": [
      "app.example.com",
      "web.example.net"
    ]
  }
}

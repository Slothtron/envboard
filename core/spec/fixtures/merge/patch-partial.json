{
  "capability": "environment.merge",
  "description": "patch 只改 dns_servers，其它字段保持不变",
  "input": {
    "base": {
      "name": "gray",
      "dns_servers": ["10.1.0.53"],
      "domain_suffix": "gray.example.com",
      "hosts": { "api.example.com": "10.1.0.11" }
    },
    "patch": { "dns_servers": ["10.2.0.53", "10.2.0.54"] }
  },
  "expect": {
    "ok": true,
    "name": "gray",
    "dns_servers": ["10.2.0.53", "10.2.0.54"],
    "domain_suffix": "gray.example.com",
    "hosts": { "api.example.com": "10.1.0.11" }
  }
}

{
  "capability": "environment.merge",
  "description": "显式 options: null = 清空回默认空对象（与“没给 options”是两件事）",
  "input": {
    "base": {
      "name": "gray",
      "listen": { "host": "127.0.0.1", "port": 16600 },
      "options": { "ssl_insecure": "true" }
    },
    "patch": { "options": null }
  },
  "expect": {
    "ok": true,
    "name": "gray",
    "listen": { "host": "127.0.0.1", "port": 16600 },
    "options": {}
  }
}

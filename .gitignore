# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Rust（核心实现）。`target/` 永不提交（构建产物一律由构建生成）；
# 而 `Cargo.lock` 必须入库 —— 它是可复现构建（`cargo build --locked`）的前提。
target/

# 本机状态（绝不应入库）
.zvec-grep/
.envboard-*.tmp
envboard.json
*.log

# 本机工作材料：设计文档、开发计划、实机验收转录。它们**故意不入库** ——
# 入库的面向交付文档只有 README.md / CHANGELOG.md / core/spec/。
.agents/

# 真实 hosts 映射：含内网 IP 与内部域名，只在本机当导入源用，不入库。
# 仓库里保留的是脱敏示例 examples/hosts.sample.txt。
/examples/hosts.txt
/examples/*.rules

# 测试 fixture 的假值 CA 必须入库（mitm.rs 消费）—— 全局 gitignore 的 *.pem
# 会静默吞掉它们，这里显式豁免。判据由 artifact 门禁钉（文件不在必红）。
!core/rs/crates/envboard-core/tests/fixtures/
!core/rs/crates/envboard-core/tests/fixtures/**

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
